# Copia este archivo a .env.local y completa los valores. En Vercel, defínelos en Settings → Environment Variables.

# Cadena "pooled" de Neon (host con -pooler). Usa un rol de aplicación, no neondb_owner.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Passkeys (WebAuthn). En desarrollo se deducen de la URL (localhost). En producción fíjalos a tu dominio:
# WEBAUTHN_RP_ID="nexo-clinico.vercel.app"
# WEBAUTHN_ORIGIN="https://nexo-clinico.vercel.app"

# true = perfiles de demostración, Passkey simulada y código de acceso visible. Déjalo en false fuera de la demo.
NEXO_DEMO_MODE=false

# Envío real del código de verificación (OTP). Se usa Gmail SMTP si está configurado; si no, Resend;
# si no hay ninguno, el código se imprime en la consola del servidor (y en pantalla si NEXO_DEMO_MODE=true).

# Opción A — Gmail SMTP: entrega a cualquier destinatario sin verificar dominio.
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="contraseña de aplicación de 16 caracteres (Cuenta de Google → Seguridad → Verificación en 2 pasos)"
# SMTP_FROM="Nexo Clínico <tu-correo@gmail.com>"

# Opción B — Resend: gratis hasta 100 correos/día, pero sin dominio verificado en resend.com/domains
# solo entrega al correo del dueño de la cuenta.
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM="Nexo Clínico <onboarding@resend.dev>"

# Consulta real de identidad (RENIEC) al verificar el DNI en /registro. Sin esta clave, se usa una
# simulación determinística por DNI (mismo comportamiento que antes).
# PERUDEVS_API_KEY="tu-clave-de-perudevs"

# Análisis de imagen (OCR) de la receta subida en /digitalizar, vía Gemini (aistudio.google.com/apikey).
# Sin esta clave, el documento pasa a revisión con la transcripción vacía para que el médico la
# complete a mano (mismo comportamiento que antes).
# GEMINI_API_KEY="tu-clave-de-gemini"
# GEMINI_MODEL="gemini-3.5-flash-lite"
